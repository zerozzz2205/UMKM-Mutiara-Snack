rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt']) &&
             data.keys().size() == 5 &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.displayName is string &&
             data.photoURL is string &&
             data.createdAt is string; // Using string for date-time format in blueprint
    }

    // Transaction Validation
    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'type', 'category', 'desc', 'amount', 'date', 'createdAt']) &&
             data.keys().size() == 7 &&
             data.userId == request.auth.uid &&
             data.type in ['income', 'expense'] &&
             data.category is string && data.category.size() <= 100 &&
             data.desc is string && data.desc.size() <= 500 &&
             data.amount is number && data.amount >= 0 &&
             data.date is string &&
             data.createdAt is string;
    }

    // Inventory Validation
    function isValidInventory(data) {
      return data.keys().hasAll(['userId', 'name', 'barcode', 'hpp', 'stock', 'shelfLife', 'price', 'createdAt']) &&
             data.keys().size() == 8 &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() <= 200 &&
             data.barcode is string && data.barcode.size() <= 100 &&
             data.hpp is number && data.hpp >= 0 &&
             data.stock is number && data.stock >= 0 &&
             data.shelfLife is number && data.shelfLife >= 0 &&
             data.price is number && data.price >= 0 &&
             data.createdAt is string;
    }

    // Production Validation
    function isValidProduction(data) {
      return data.keys().hasAll(['userId', 'batchCode', 'sku', 'productName', 'qty', 'expiryDate', 'hpp', 'timestamp']) &&
             data.keys().size() == 8 &&
             data.userId == request.auth.uid &&
             data.batchCode is string && data.batchCode.size() <= 100 &&
             data.sku is string && data.sku.size() <= 100 &&
             data.productName is string && data.productName.size() <= 200 &&
             data.qty is number && data.qty >= 0 &&
             data.expiryDate is string && data.expiryDate.size() <= 100 &&
             data.hpp is number && data.hpp >= 0 &&
             data.timestamp is string;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL'])
      );
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidTransaction(incoming());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && isValidTransaction(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['category', 'desc', 'amount', 'date'])
      );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Inventory Collection
    match /inventory/{skuCode} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidInventory(incoming()) && isValidId(skuCode);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && isValidInventory(incoming()) && isValidId(skuCode) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'barcode', 'hpp', 'stock', 'shelfLife', 'price'])
      );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid && isValidId(skuCode);
    }

    // Production Collection
    match /production/{batchId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidProduction(incoming()) && isValidId(batchId);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && isValidProduction(incoming()) && isValidId(batchId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['qty', 'expiryDate', 'hpp'])
      );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid && isValidId(batchId);
    }
  }
}
