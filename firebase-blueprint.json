{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "User profile photo URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp" }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A single cash flow transaction",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the owner" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string" },
        "desc": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "category", "desc", "amount", "date"]
    },
    "RawMaterial": {
      "title": "Raw Material Item",
      "description": "A raw material ingredient used for production",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the owner" },
        "name": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "pricePerUnit": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "quantity", "unit", "pricePerUnit", "createdAt"]
    },
    "Product": {
      "title": "Product Item or SKU",
      "description": "A finished product ready for sale",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the owner" },
        "name": { "type": "string" },
        "quantity": { "type": "number" },
        "hpp": { "type": "number" },
        "price": { "type": "number" },
        "barcode": { "type": "string" },
        "shelfLife": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "quantity", "hpp", "price", "barcode", "shelfLife", "createdAt"]
    },
    "ProductionRecord": {
      "title": "Production Record Log",
      "description": "A historical log of production batch runs",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the owner" },
        "batchCode": { "type": "string" },
        "productName": { "type": "string" },
        "qty": { "type": "number" },
        "hpp": { "type": "number" },
        "status": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "materialsUsed": { "type": "array" }
      },
      "required": ["userId", "batchCode", "productName", "qty", "hpp", "status", "timestamp", "materialsUsed"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Global transactions (filtered by userId)"
    },
    "raw_materials/{materialId}": {
      "schema": "RawMaterial",
      "description": "Ingredients and materials used in production"
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "Product catalog and finished items stocks"
    },
    "productions/{productionId}": {
      "schema": "ProductionRecord",
      "description": "Historical log of finished production runs"
    }
  }
}
