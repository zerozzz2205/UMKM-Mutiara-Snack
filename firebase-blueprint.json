{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "User profile photo URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp" }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A single cash flow transaction",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the owner" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string" },
        "desc": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "category", "desc", "amount", "date"]
    },
    "Inventory": {
      "title": "Inventory Item",
      "description": "An inventory product catalog item",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the owner" },
        "name": { "type": "string" },
        "barcode": { "type": "string" },
        "hpp": { "type": "number" },
        "stock": { "type": "number" },
        "shelfLife": { "type": "number" },
        "price": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "hpp", "stock", "shelfLife", "price"]
    },
    "Production": {
      "title": "Production Batch",
      "description": "A production history batch log",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the owner" },
        "batchCode": { "type": "string" },
        "sku": { "type": "string" },
        "productName": { "type": "string" },
        "qty": { "type": "number" },
        "expiryDate": { "type": "string" },
        "hpp": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "batchCode", "sku", "productName", "qty", "expiryDate", "hpp", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Global transactions (filtered by userId)"
    },
    "inventory/{skuCode}": {
      "schema": "Inventory",
      "description": "Product catalog and stock quantities"
    },
    "production/{batchId}": {
      "schema": "Production",
      "description": "History of production batches"
    }
  }
}
